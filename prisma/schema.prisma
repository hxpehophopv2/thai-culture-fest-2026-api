generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  USER
  TEACHER
  STAFF
  ADMIN

  @@map("user_role")
}

enum BookingStatus {
  CONFIRMED
  CANCELLED

  @@map("booking_status")
}

enum ScanResult {
  CHECKED_IN
  WRONG_BASE
  WRONG_TIME
  REJECTED
  MANUAL_CHECKED_IN

  @@map("scan_result")
}

enum QrSubjectType {
  BOOKING
  STUDENT

  @@map("qr_subject_type")
}

model User {
  id          String   @id @default(uuid()) @db.Uuid
  lineUserId  String   @unique @map("line_user_id")
  displayName String?  @map("display_name")
  role        UserRole @default(USER)
  schoolName  String?  @map("school_name")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  students        Student[]
  bookings        Booking[]
  staffSessions   StaffSession[]
  scanLogsAsStaff ScanLog[]      @relation("ScanLogStaff")

  @@map("users")
}

model Event {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  startsAt  DateTime @map("starts_at")
  endsAt    DateTime @map("ends_at")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  activities Activity[]

  @@map("events")
}

model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @map("event_id") @db.Uuid
  name        String
  baseNumber  Int      @map("base_number")
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  event Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  slots Slot[]

  @@unique([eventId, baseNumber])
  @@index([eventId, isActive])
  @@map("activities")
}

model Slot {
  id          String   @id @default(uuid()) @db.Uuid
  activityId  String   @map("activity_id") @db.Uuid
  startTime   DateTime @map("start_time")
  endTime     DateTime @map("end_time")
  capacity    Int
  bookedCount Int      @default(0) @map("booked_count")
  isVisible   Boolean  @default(true) @map("is_visible")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  activity Activity  @relation(fields: [activityId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([activityId, isVisible])
  @@index([startTime])
  @@map("slots")
}

model Student {
  id          String   @id @default(uuid()) @db.Uuid
  teacherId   String   @map("teacher_id") @db.Uuid
  firstName   String   @map("first_name")
  lastName    String   @map("last_name")
  studentCode String?  @map("student_code")
  classRoom   String?  @map("class_room")
  schoolName  String?  @map("school_name")
  qrJti       String?  @unique @map("qr_jti")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  teacher  User      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  bookings Booking[]
  scanLogs ScanLog[]

  @@index([teacherId])
  @@index([schoolName, classRoom])
  @@index([firstName, lastName])
  @@map("students")
}

model Booking {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String?       @map("user_id") @db.Uuid
  studentId       String?       @map("student_id") @db.Uuid
  parentBookingId String?       @map("parent_booking_id") @db.Uuid
  slotId          String        @map("slot_id") @db.Uuid
  status          BookingStatus @default(CONFIRMED)
  qrJti           String?       @unique @map("qr_jti")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user          User?     @relation(fields: [userId], references: [id], onDelete: Restrict)
  student       Student?  @relation(fields: [studentId], references: [id], onDelete: Restrict)
  slot          Slot      @relation(fields: [slotId], references: [id], onDelete: Restrict)
  parentBooking Booking?  @relation("BookingChildren", fields: [parentBookingId], references: [id], onDelete: SetNull)
  childBookings Booking[] @relation("BookingChildren")
  scanLogs      ScanLog[]

  @@unique([userId, slotId])
  @@unique([studentId, slotId])
  @@index([slotId, status])
  @@index([userId])
  @@index([studentId])
  @@map("bookings")
}

model StaffSession {
  id        String    @id @default(uuid()) @db.Uuid
  staffId   String    @map("staff_id") @db.Uuid
  baseNumber Int      @map("base_number")
  startedAt DateTime  @default(now()) @map("started_at")
  endedAt   DateTime? @map("ended_at")

  staff    User      @relation(fields: [staffId], references: [id], onDelete: Restrict)
  scanLogs ScanLog[]

  @@index([staffId, endedAt])
  @@index([baseNumber, endedAt])
  @@map("staff_sessions")
}

model ScanLog {
  id                String      @id @default(uuid()) @db.Uuid
  scannedAt         DateTime    @default(now()) @map("scanned_at")
  bookingId         String?     @map("booking_id") @db.Uuid
  studentId         String?     @map("student_id") @db.Uuid
  studentName       String?     @map("student_name")
  actualBaseNumber  Int         @map("actual_base_number")
  expectedBaseNumber Int?       @map("expected_base_number")
  expectedSlotStart DateTime?   @map("expected_slot_start")
  result            ScanResult
  isOverride        Boolean     @default(false) @map("is_override")
  isManual          Boolean     @default(false) @map("is_manual")
  staffId           String      @map("staff_id") @db.Uuid
  staffSessionId    String?     @map("staff_session_id") @db.Uuid
  qrSubjectType     QrSubjectType? @map("qr_subject_type")
  qrSubjectId       String?     @map("qr_subject_id") @db.Uuid
  note              String?

  booking      Booking?      @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  student      Student?      @relation(fields: [studentId], references: [id], onDelete: SetNull)
  staff        User          @relation("ScanLogStaff", fields: [staffId], references: [id], onDelete: Restrict)
  staffSession StaffSession? @relation(fields: [staffSessionId], references: [id], onDelete: SetNull)

  @@index([actualBaseNumber, result])
  @@index([studentId])
  @@index([bookingId])
  @@index([staffSessionId])
  @@index([scannedAt])
  @@map("scan_logs")
}
